# SurakṣāMārga.ai - Environment Configuration
# Copy this file to backend/.env and fill in the values

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/surakshamarga

# Google Maps API Key (optional - OSRM is used as free fallback)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Routing provider: "google" or "osrm" (default: osrm - no API key needed)
ROUTING_PROVIDER=osrm

# OSRM public server (rate-limited but works for demos)
OSRM_BASE_URL=http://router.project-osrm.org

# CORS origins (use * for development)
CORS_ORIGINS=*

# Risk engine config
CRIME_QUERY_RADIUS_METERS=200
ROUTE_SAMPLE_INTERVAL_METERS=100
